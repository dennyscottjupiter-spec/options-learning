<!doctype html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ s.app_title }}</title>
<script>
(function () {
  var t = localStorage.getItem("optionslab-theme");
  if (!t) { t = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light"; }
  document.documentElement.setAttribute("data-theme", t);
})();
</script>
<link rel="stylesheet" href="{{ asset_prefix | default('/static') }}/css/report.css">
<script src="{{ asset_prefix | default('/static') }}/js/theme.js"></script>
</head>
<body>
<div class="page">

  <header class="report-header">
    <div class="titles">
      <h1>{{ s.app_title }}</h1>
      <p class="subtitle">{{ s.app_tagline }}</p>
    </div>
    <div class="header-controls">
      <a class="flag-toggle" href="{{ lang_toggle_href }}">{% include "_flag_br.html.jinja" %} {{ s.lang_toggle }}</a>
      {% include "_help_toggle.html.jinja" %}
      {% include "_theme_toggle.html.jinja" %}
    </div>
  </header>

  {% include "_help_modal.html.jinja" %}

  <section class="panel">
    <h2>{{ s.home_analyze_title }}</h2>
    <form method="get" action="/analyze" class="form-row">
      <div class="field">
        <label for="ticker">{{ s.ticker_label }}</label>
        <input id="ticker" name="ticker" type="text" placeholder="{{ s.ticker_placeholder }}" required autocapitalize="characters" autocomplete="off">
      </div>
      <div class="field">
        <label for="strategy">{{ s.strategy_label }}</label>
        <select id="strategy" name="strategy">
          {% for value, label in strategy_options %}
          <option value="{{ value }}">{{ label }}</option>
          {% endfor %}
        </select>
      </div>
      <div class="field">
        <label for="expiration">{{ s.expiration_override_label }}</label>
        <input id="expiration" name="expiration" type="date">
      </div>
      <input type="hidden" name="lang" value="{{ lang }}">
      <button type="submit" class="btn-primary">{{ s.analyze_button }}</button>
    </form>
  </section>

  <section class="panel">
    <h2>{{ s.watchlist_title }}</h2>
    {% if cards %}
    <div class="watchlist-grid">
      {% for card in cards %}
      <div class="ticker-card">
        <div class="card-top">
          <span class="symbol">{{ card.ticker }}</span>
          <form method="post" action="/watchlist/remove">
            <input type="hidden" name="ticker" value="{{ card.ticker }}">
            <input type="hidden" name="lang" value="{{ lang }}">
            <button type="submit" class="remove-btn" aria-label="{{ s.remove_button }}">×</button>
          </form>
        </div>
        {% if card.ok %}
        <span class="company">{{ card.company_name }}</span>
        <div class="price-row">
          <span class="price">{{ card.price | money }}</span>
          <span class="change {{ 'pl-positive' if card.change_pct >= 0 else 'pl-negative' }}">{{ "%+.2f"|format(card.change_pct) }}%</span>
        </div>
        {% else %}
        <span class="company">{{ s.data_unavailable }}</span>
        {% endif %}
        <a class="btn-secondary" href="/report/{{ card.ticker }}?strategy=long_call&amp;mode=learn&amp;lang={{ lang }}">{{ s.view_report }} →</a>
      </div>
      {% endfor %}
    </div>
    {% else %}
    <p class="empty-state">{{ s.watchlist_empty }}</p>
    {% endif %}

    <form method="post" action="/watchlist/add" class="form-row watchlist-add-form">
      <div class="field">
        <label for="add-ticker">{{ s.watchlist_add_placeholder }}</label>
        <input id="add-ticker" name="ticker" type="text" placeholder="{{ s.ticker_placeholder }}" required autocapitalize="characters" autocomplete="off">
      </div>
      <input type="hidden" name="lang" value="{{ lang }}">
      <button type="submit" class="btn-secondary">{{ s.add_to_watchlist_button }}</button>
    </form>
  </section>

  <p class="footer-note">{{ s.footer_disclaimer }}</p>

</div>
</body>
</html>
