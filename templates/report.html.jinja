<!doctype html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ s.report_title }} — {{ ticker }}</title>
<script>
(function () {
  var t = localStorage.getItem("optionslab-theme");
  if (!t) { t = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light"; }
  document.documentElement.setAttribute("data-theme", t);
})();
</script>
<link rel="stylesheet" href="{{ asset_prefix | default('/static') }}/css/report.css">
<script src="{{ asset_prefix | default('/static') }}/js/theme.js"></script>
</head>
<body>
<div class="page">

  <header class="report-header">
    <div class="titles">
      <h1>{{ ticker }} — {{ strategy_name }}</h1>
      <p class="subtitle">{{ company_name }} · {{ s.generated_on }} {{ generated_at }}</p>
    </div>
    <div class="header-controls">
      <nav class="pill-toggle" aria-label="Report depth">
        <a href="{{ nav.mode_learn_href }}" class="{{ 'active' if mode == 'learn' else '' }}">{{ s.mode_learn }}</a>
        <a href="{{ nav.mode_pro_href }}" class="{{ 'active' if mode == 'pro' else '' }}">{{ s.mode_pro }}</a>
      </nav>
      <a class="flag-toggle" href="{{ nav.lang_toggle_href }}">{% if lang == 'en' %}{% include "_flag_br.html.jinja" %}{% else %}{% include "_flag_uk.html.jinja" %}{% endif %} {{ s.lang_toggle }}</a>
      {% include "_help_toggle.html.jinja" %}
      {% include "_theme_toggle.html.jinja" %}
    </div>
  </header>

  {% include "_help_modal.html.jinja" %}

  <section class="panel">
    <div class="stat-row">
      <div class="stat">
        <span class="label">{{ s.spot_price }}</span>
        <span class="value">{{ spot_price | money }}</span>
      </div>
      <div class="stat">
        <span class="label">{{ s.sector }}</span>
        <span class="value" style="font-family: var(--font-body); font-size: 15px;">{{ sector or "—" }}</span>
      </div>
      <div class="stat">
        <span class="label">{{ s.market_cap }}</span>
        <span class="value">{{ market_cap_display }}</span>
      </div>
      <div class="stat">
        <span class="label">{{ s.next_earnings }}</span>
        <span class="value" style="font-size: 15px;">{{ next_earnings_date or "—" }}</span>
      </div>
    </div>
  </section>

  {% if static_export %}
  <div class="warning static-demo">
    <h3>◆ {{ s.static_demo_title }}</h3>
    <p>{{ s.static_demo_body }} <a href="index.html">{{ s.back_to_dashboard }}</a></p>
  </div>
  {% else %}
  <div class="control-bar">
    <a class="btn-secondary" href="/?lang={{ lang }}">{{ s.back_to_dashboard }}</a>
    <div class="control-actions">
      {% if in_watchlist %}
      <form method="post" action="/watchlist/remove">
        <input type="hidden" name="ticker" value="{{ ticker }}">
        <input type="hidden" name="lang" value="{{ lang }}">
        <button type="submit" class="btn-secondary">{{ s.remove_button }}</button>
      </form>
      {% else %}
      <form method="post" action="/watchlist/add">
        <input type="hidden" name="ticker" value="{{ ticker }}">
        <input type="hidden" name="lang" value="{{ lang }}">
        <button type="submit" class="btn-secondary">{{ s.add_to_watchlist_button }}</button>
      </form>
      {% endif %}
      <a class="btn-primary" href="/report/{{ ticker }}/pdf?strategy={{ strategy_type }}&amp;mode={{ mode }}&amp;lang={{ lang }}&amp;expiration={{ strategy.expiration }}">{{ s.download_pdf }}</a>
    </div>
  </div>

  <section class="panel adjust-selection">
    <h2>{{ s.adjust_selection_title }}</h2>
    <form method="get" action="/report/{{ ticker }}" class="form-row">
      <div class="field">
        <label for="strategy">{{ s.strategy_label }}</label>
        <select id="strategy" name="strategy">
          {% for value, label in strategy_options %}
          <option value="{{ value }}" {{ 'selected' if value == strategy_type else '' }}>{{ label }}</option>
          {% endfor %}
        </select>
      </div>
      <div class="field">
        <label for="expiration">{{ s.expiration_override_label }}</label>
        <input id="expiration" name="expiration" type="date" value="{{ strategy.expiration }}">
      </div>
      <input type="hidden" name="mode" value="{{ mode }}">
      <input type="hidden" name="lang" value="{{ lang }}">
      <button type="submit" class="btn-primary">{{ s.update_button }}</button>
    </form>
  </section>
  {% endif %}

  {% if earnings_warning %}
  <div class="warning earnings">
    <h3>⚠ {{ s.earnings_warning_title }}</h3>
    <p>{{ s.earnings_warning_body }}</p>
  </div>
  {% endif %}

  {% if not best.liquidity_ok %}
  <div class="warning liquidity">
    <h3>⚠ {{ s.liquidity_warning_title }}</h3>
    <p>{{ s.liquidity_warning_body }}</p>
  </div>
  {% endif %}

  {% if not best.affordable %}
  <div class="warning affordability">
    <h3>⚠ {{ s.affordability_warning_title }}</h3>
    <p>{{ s.affordability_warning_body }}</p>
  </div>
  {% endif %}

  <section class="panel">
    <h2>{{ strategy_name }}</h2>
    <p class="blurb">{{ strategy_blurb }}</p>
    {{ payoff_svg | safe }}
  </section>

  <section class="panel">
    <h2>{{ s.contract_section }}</h2>
    <div class="stat-row">
      <div class="stat">
        <span class="label">{{ s.strike }}</span>
        <span class="value">{{ strategy.strike | money }}</span>
      </div>
      <div class="stat">
        <span class="label">{{ s.expiration }}</span>
        <span class="value" style="font-size: 15px;">{{ strategy.expiration }}</span>
      </div>
      <div class="stat">
        <span class="label">{{ s.dte }}</span>
        <span class="value">{{ best.dte }}</span>
      </div>
      <div class="stat">
        <span class="label">{{ s.premium }}</span>
        <span class="value">{{ strategy.premium | money }}</span>
      </div>
      <div class="stat">
        <span class="label">{{ s.breakeven }}</span>
        <span class="value">{{ strategy.breakeven[0] | money }}</span>
      </div>
      <div class="stat">
        <span class="label">{{ s.max_profit }}</span>
        <span class="value pl-positive">
          {% if strategy.max_profit is none %}{{ s.unlimited }}{% else %}{{ strategy.max_profit | money }}{% endif %}
        </span>
      </div>
      <div class="stat">
        <span class="label">{{ s.max_loss }}</span>
        <span class="value pl-negative">{{ strategy.max_loss | money }}</span>
      </div>
      <div class="stat">
        <span class="label">{{ s.capital_required }}</span>
        <span class="value">{{ strategy.capital_required | money }}</span>
      </div>
    </div>
    {% if mode == 'learn' %}
    <p class="teach">{{ s.breakeven_vs_strike_note }}</p>
    {% endif %}
  </section>

  <section class="panel">
    <h2>{{ s.greeks_section }}</h2>
    <div class="stat-row">
      <div class="stat">
        <span class="label">{{ s.delta }}</span>
        <span class="value {{ 'source-local' if contract.greeks_source == 'calculated locally' else '' }}">{{ "%.3f"|format(contract.delta) }}</span>
      </div>
      <div class="stat">
        <span class="label">{{ s.gamma }}</span>
        <span class="value {{ 'source-local' if contract.greeks_source == 'calculated locally' else '' }}">{{ "%.4f"|format(contract.gamma) }}</span>
      </div>
      <div class="stat">
        <span class="label">{{ s.theta }}</span>
        <span class="value {{ 'source-local' if contract.greeks_source == 'calculated locally' else '' }}">{{ "%.3f"|format(contract.theta) }}</span>
      </div>
      <div class="stat">
        <span class="label">{{ s.vega }}</span>
        <span class="value {{ 'source-local' if contract.greeks_source == 'calculated locally' else '' }}">{{ "%.3f"|format(contract.vega) }}</span>
      </div>
      <div class="stat">
        <span class="label">{{ s.rho }}</span>
        <span class="value {{ 'source-local' if contract.greeks_source == 'calculated locally' else '' }}">{{ "%.3f"|format(contract.rho) }}</span>
      </div>
      <div class="stat">
        <span class="label">{{ s.implied_volatility }}</span>
        <span class="value {{ 'source-local' if contract.greeks_source == 'calculated locally' else '' }}">{{ "%.1f"|format(contract.implied_volatility * 100) }}%</span>
      </div>
    </div>
    <p class="caption">
      {% if contract.greeks_source == 'calculated locally' %}
        * {{ s.greeks_source_local }}
      {% else %}
        {{ s.greeks_source_alpaca }}
      {% endif %}
    </p>
  </section>

  <section class="panel">
    <h2>{{ s.probability_section }}</h2>
    <div class="stat-row">
      <div class="stat">
        <span class="label">{{ s.pop_closed_form }}</span>
        <span class="value">{{ "%.1f"|format(best.pop_closed_form * 100) }}%</span>
      </div>
      <div class="stat">
        <span class="label">{{ s.pop_monte_carlo }}</span>
        <span class="value">{{ "%.1f"|format(best.pop_monte_carlo * 100) }}%</span>
      </div>
      <div class="stat">
        <span class="label">{{ s.probability_of_touch }}</span>
        <span class="value">{{ "%.1f"|format(best.probability_of_touch * 100) }}%</span>
      </div>
      <div class="stat">
        <span class="label">{{ s.avg_win }}</span>
        <span class="value pl-positive">{{ best.avg_win | money }}</span>
      </div>
      <div class="stat">
        <span class="label">{{ s.avg_loss }}</span>
        <span class="value pl-negative">{{ (best.avg_loss * -1) | money }}</span>
      </div>
      <div class="stat">
        <span class="label">{{ s.score }}</span>
        <span class="value">{{ "%.4f"|format(best.score) }}</span>
      </div>
    </div>
    {% if best.pop_disagreement_flag %}
    <p class="teach">⚠ {{ s.pop_disagreement }}</p>
    {% endif %}
    {% if mode == 'learn' %}
    <p class="teach">{{ s.expected_return_note }}</p>
    {% endif %}
    {% if why_best %}
    <p class="caption"><strong>{{ s.why_best }}:</strong> {{ why_best }} ({{ s.candidates_evaluated }}: {{ candidates_evaluated }})</p>
    {% endif %}

    <div class="methodology">
      <h3>{{ s.methodology_title }}</h3>
      <p class="methodology-intro">{{ s.methodology_intro }} <span class="path">{{ src_dir }}/</span></p>
      <div class="methodology-table-wrap">
        <table class="methodology-table">
          <thead>
            <tr>
              <th>{{ s.methodology_col_metric }}</th>
              <th>{{ s.methodology_col_formula }}</th>
              <th>{{ s.methodology_col_source }}</th>
            </tr>
          </thead>
          <tbody>
            {% for row in methodology %}
            <tr>
              <td>{{ s[row.metric_key] }}</td>
              <td class="formula">{{ row.formula_html }}</td>
              <td class="source">{{ row.source_html }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="panel">
    <h2>{{ s.technical_section }}</h2>
    <div class="stat-row">
      <div class="stat">
        <span class="label">{{ s.sma20 }}</span>
        <span class="value">{{ indicators.sma20 | money }}</span>
      </div>
      <div class="stat">
        <span class="label">{{ s.sma50 }}</span>
        <span class="value">{{ indicators.sma50 | money }}</span>
      </div>
      <div class="stat">
        <span class="label">{{ s.sma200 }}</span>
        <span class="value">{{ indicators.sma200 | money }}</span>
      </div>
      <div class="stat">
        <span class="label">{{ s.rsi14 }}</span>
        <span class="value">{{ "%.1f"|format(indicators.rsi14) }}</span>
      </div>
      <div class="stat">
        <span class="label">{{ s.hv30 }}</span>
        <span class="value">{{ "%.1f"|format(indicators.hv30 * 100) }}%</span>
        <span class="caption">{{ "%.0f"|format(indicators.hv30_percentile) }} {{ s.percentile_suffix }}</span>
      </div>
      <div class="stat">
        <span class="label">{{ s.hv90 }}</span>
        <span class="value">{{ "%.1f"|format(indicators.hv90 * 100) }}%</span>
        <span class="caption">{{ "%.0f"|format(indicators.hv90_percentile) }} {{ s.percentile_suffix }}</span>
      </div>
      <div class="stat">
        <span class="label">{{ s.range_52w }}</span>
        <span class="value" style="font-size: 15px;">{{ indicators.low_52w | money }} – {{ indicators.high_52w | money }}</span>
      </div>
      <div class="stat">
        <span class="label">{{ s.directional_bias }}</span>
        <span class="value" style="font-size: 15px;">{{ bias_display }}</span>
      </div>
    </div>
  </section>

  <p class="footer-note">{{ s.footer_disclaimer }}</p>

</div>
</body>
</html>
